<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme with Action Bar -->
    <style name="Theme.VQueue" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>

        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>

        <!-- Background / Surface -->
        <item name="android:colorBackground">@color/background_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- System bar colors -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- No Action Bar version (for HomeFragment or Splash) -->
    <style name="Theme.VQueue.NoActionBar" parent="Theme.VQueue">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">true</item>
    </style>

</resources>
