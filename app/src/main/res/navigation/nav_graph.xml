<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="et.dev.eyobed.vqueue.fragments.HomeFragment"
        android:label="VQueue">
        <action
            android:id="@+id/action_homeFragment_to_queueManagerFragment"
            app:destination="@id/queueManagerFragment"
            app:popUpTo="@id/homeFragment" />
        <action
            android:id="@+id/action_homeFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_aboutFragment"
            app:destination="@id/aboutFragment" />
        <action
            android:id="@+id/action_homeFragment_to_waitFragment"
            app:destination="@id/waitFragment" />

    </fragment>

    <fragment
        android:id="@+id/queueManagerFragment"
        android:name="et.dev.eyobed.vqueue.fragments.QueueManagerFragment"
        android:label="Manage Queue">
        <action
            android:id="@+id/action_queueManagerFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/waitFragment"
        android:name="et.dev.eyobed.vqueue.fragments.WaitFragment"
        android:label="Waiting in Queue">
        <action
            android:id="@+id/action_waitFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="et.dev.eyobed.vqueue.fragments.SettingsFragment"
        android:label="Settings" />

    <fragment
        android:id="@+id/aboutFragment"
        android:name="et.dev.eyobed.vqueue.fragments.AboutFragment"
        android:label="About" />
</navigation>