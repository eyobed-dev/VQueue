<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.VQueue.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_small"
    android:layout_marginLeft="@dimen/margin_small"
    android:layout_marginRight="@dimen/margin_small"
    android:layout_marginTop="@dimen/margin_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/padding_medium"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/ticketNumberText"
            style="@style/TextAppearance.VQueue.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#5"
            android:minWidth="40dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/padding_medium"
            android:paddingEnd="@dimen/padding_medium">

            <TextView
                android:id="@+id/deviceIdText"
                style="@style/TextAppearance.VQueue.Body1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device ID" />

            <TextView
                android:id="@+id/statusText"
                style="@style/TextAppearance.VQueue.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waiting" />

        </LinearLayout>

        <ImageView
            android:id="@+id/statusIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_queue"
            app:tint="@color/text_secondary" />

    </LinearLayout>

</androidx.cardview.widget.CardView>