<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardView"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:layout_margin="6dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/text_on_primary"
        app:cardCornerRadius="80dp"
        app:cardElevation="4dp"
        app:rippleColor="@color/primary"
        app:strokeWidth="0dp">

        <!-- Content container centered in the circle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Text Color changed to colorOnPrimary for contrast -->
            <TextView
                android:id="@+id/queueName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Device Name"
                android:textSize="16dp"
                android:textColor="@color/primary"
                android:textStyle="bold"
                tools:text="Doctor Smith" />

            <!-- Optional: Show wait time if available -->
            <TextView
                android:id="@+id/queueWaitInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="15 min"
                android:textSize="10dp"
                android:textColor="@color/primary"
                android:alpha="0.8"
                tools:text="~15 min wait" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>