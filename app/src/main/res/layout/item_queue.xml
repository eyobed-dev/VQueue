<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/padding_small"
    android:paddingEnd="@dimen/padding_small"
    android:paddingTop="@dimen/padding_small"
    android:paddingBottom="0dp">

    <!-- MD1 Card: Square corners (2dp), proper elevation -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        style="@style/Widget.VQueue.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_medium">

            <!-- Color Circle (Avatar/Icon placeholder) -->
            <!-- Using simple View circle is fine, kept as is but ensured alignment -->
            <View
                android:id="@+id/colorCircle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_background"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <!-- Queue Name -->
            <TextView
                android:id="@+id/queueName"
                style="@style/TextAppearance.VQueue.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_small"
                android:text="Queue Name"
                android:ellipsize="end"
                android:maxLines="1"
                app:layout_constraintStart_toEndOf="@id/colorCircle"
                app:layout_constraintEnd_toStartOf="@+id/rssi"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/queueWaitInfo"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="Dr. Smith's Office"/>

            <!-- Wait Info -->
            <TextView
                android:id="@+id/queueWaitInfo"
                style="@style/TextAppearance.VQueue.Body1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_small"
                android:text="Wait info"
                app:layout_constraintStart_toEndOf="@id/colorCircle"
                app:layout_constraintEnd_toStartOf="@+id/rssi"
                app:layout_constraintTop_toBottomOf="@id/queueName"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="15 min wait"/>

            <!-- RSSI -->
            <TextView
                android:id="@+id/rssi"
                style="@style/TextAppearance.VQueue.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-55 dBm"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
</FrameLayout>