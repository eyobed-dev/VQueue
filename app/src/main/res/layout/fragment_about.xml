<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_large">

        <!-- App Icon & Title Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="@dimen/margin_xlarge">

            <ImageView
                android:id="@+id/appIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher_round" />

            <TextView
                android:id="@+id/appNameText"
                style="@style/TextAppearance.VQueue.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:text="@string/app_name"
                android:fontFamily="sans-serif-light" />

            <TextView
                android:id="@+id/versionText"
                style="@style/TextAppearance.VQueue.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                tools:text="Version 1.0.0" />

        </LinearLayout>

        <!-- Description Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/descriptionCard"
            style="@style/Widget.VQueue.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_medium">

                <TextView
                    style="@style/TextAppearance.VQueue.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/padding_small"
                    android:text="About the App" />

                <TextView
                    style="@style/TextAppearance.VQueue.Body1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="VQueue is a Bluetooth Low Energy (BLE) based queue management system that allows devices to create and join virtual queues locally without requiring internet connectivity."
                    android:lineSpacingMultiplier="1.5" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Developer Info Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/developerCard"
            style="@style/Widget.VQueue.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_medium">

                <TextView
                    style="@style/TextAppearance.VQueue.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/padding_small"
                    android:text="Developers" />

                <TextView
                    style="@style/TextAppearance.VQueue.Body1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/padding_medium"
                    android:text="Developed by Eyobed, Kaung, Lucas, Adam and Krystof as part of a project for TAMa at:"
                    android:lineSpacingMultiplier="1.5" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="Brno University of Technology, Faculty of Information Technology Logo"
                    android:src="@drawable/fit_logo"
                    android:maxHeight="@dimen/button_height"
                    android:scaleType="fitStart" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Contact & Feedback Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/contactCard"
            style="@style/Widget.VQueue.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_medium">

                <TextView
                    style="@style/TextAppearance.VQueue.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/padding_small"
                    android:text="Contact &amp; Feedback" />

                <!-- GitLab Link -->
                <TextView
                    android:id="@+id/gitlabLink"
                    style="@style/TextAppearance.VQueue.Body1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/button_height"
                    android:text="View on GitLab"
                    android:textColor="@color/primary"
                    android:gravity="center_vertical"
                    android:paddingTop="@dimen/padding_small"
                    android:paddingBottom="@dimen/padding_small"
                    android:drawablePadding="@dimen/margin_medium"
                    android:drawableTint="@color/primary"
                    android:background="?android:attr/selectableItemBackground"
                    app:drawableStartCompat="@drawable/gitlab_icon" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider" />

                <!-- Email Link -->
                <TextView
                    android:id="@+id/emailLink"
                    style="@style/TextAppearance.VQueue.Body1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/button_height"
                    android:text="Send an Email"
                    android:textColor="@color/primary"
                    android:gravity="center_vertical"
                    android:paddingTop="@dimen/padding_small"
                    android:paddingBottom="@dimen/padding_small"
                    android:drawablePadding="@dimen/margin_medium"
                    android:drawableTint="@color/primary"
                    android:background="?android:attr/selectableItemBackground"
                    app:drawableStartCompat="@drawable/ic_email" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>