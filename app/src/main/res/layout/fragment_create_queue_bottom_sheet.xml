<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/padding_medium"
    android:background="@color/surface">

    <!-- Header -->
    <TextView
        android:id="@+id/headerText"
        style="@style/TextAppearance.VQueue.Headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create a Queue"
        android:layout_marginBottom="@dimen/margin_medium" />

    <!-- Queue Name Input - Using classic line style (implied by styles in themes.xml) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/queueNameLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:hint="Queue Name"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
        app:boxBackgroundColor="@android:color/transparent"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp">

        <EditText
            android:id="@+id/queueNameEditText"
            style="@style/Widget.VQueue.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Wait Time Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/waitTimeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:hint="Wait Time (min)"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
        app:boxBackgroundColor="@android:color/transparent"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp">

        <EditText
            android:id="@+id/waitTimeEditText"
            style="@style/Widget.VQueue.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Create Queue Button -->
    <Button
        android:id="@+id/createQueueButton"
        style="@style/Widget.VQueue.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large"
        android:layout_marginBottom="@dimen/margin_medium"
        android:text="Create" />

</LinearLayout>