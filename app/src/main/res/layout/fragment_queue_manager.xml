<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header Section (Simulating Paper Layer) -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:padding="@dimen/padding_large"
        android:elevation="@dimen/elevation_card_resting"
        android:orientation="vertical">

        <TextView
            android:id="@+id/headerText"
            style="@style/TextAppearance.VQueue.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Queue Manager"
            android:textColor="@color/on_primary"/>

        <TextView
            android:id="@+id/statusText"
            style="@style/TextAppearance.VQueue.Subhead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:text="Manage your active queue"
            android:textColor="@color/on_primary" />

    </LinearLayout>

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/padding_medium">

            <!-- Queue Info Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/queueInfoCard"
                style="@style/Widget.VQueue.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_medium">

                    <!-- Queue Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="@dimen/padding_medium">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_queue"
                            android:contentDescription="Queue icon"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:id="@+id/queueNameText"
                            style="@style/TextAppearance.VQueue.Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/margin_medium"
                            android:text="Coffee Shop Queue" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginBottom="@dimen/margin_medium" />

                    <!-- Current Number -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/padding_small">

                        <TextView
                            style="@style/TextAppearance.VQueue.Body1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Current Number"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/currentNumberText"
                            style="@style/TextAppearance.VQueue.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <!-- Wait Time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/padding_small">

                        <TextView
                            style="@style/TextAppearance.VQueue.Body1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Estimated Wait Time"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/waitTimeText"
                            style="@style/TextAppearance.VQueue.Body1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10 min" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <!-- People in Queue -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/padding_small">

                        <TextView
                            style="@style/TextAppearance.VQueue.Body1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="People in Queue"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/queueSizeText"
                            style="@style/TextAppearance.VQueue.Body1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Waiters List Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/padding_medium"
                android:paddingEnd="@dimen/padding_medium"
                android:paddingBottom="@dimen/bottom_bar_height">

                <TextView
                    style="@style/TextAppearance.VQueue.Subhead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="People in Queue"
                    android:paddingBottom="@dimen/padding_small"
                    android:textColor="@color/text_secondary"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/waitersRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/emptyStateText"
                    style="@style/TextAppearance.VQueue.Body1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No one is currently in the queue."
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:padding="@dimen/padding_medium"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar (Paper Strip) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_bar_height"
        android:orientation="horizontal"
        android:elevation="8dp"
        android:background="@color/surface">

        <!-- Buttons without borders or rounded corners in the bottom bar, just colored blocks or text buttons -->
        <!-- However, MD1 usually suggests FABs or Raised buttons for primary actions. The existing layout had a bar of buttons. -->
        <!-- I'll keep them as "Flat" buttons style but with background colors to distinct actions, mimicking a custom toolbar or tab strip -->

        <!-- Next Button (Green) -->
        <Button
            android:id="@+id/nextButton"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Next"
            android:textColor="@android:color/white"
            android:background="@color/functional_green"
            android:drawableStart="@drawable/ic_arrow_forward"
            android:drawableTint="@android:color/white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <!-- Manual Add Button (Blue) -->
        <Button
            android:id="@+id/manualAddButton"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Add"
            android:textColor="@android:color/white"
            android:background="@color/functional_blue"
            android:drawableStart="@drawable/ic_add"
            android:drawableTint="@android:color/white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <!-- Pause Button (Orange) -->
        <Button
            android:id="@+id/pauseButton"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:text="Pause"
            android:textColor="@android:color/white"
            android:background="@color/functional_orange"
            android:drawableStart="@drawable/ic_pause"
            android:drawableTint="@android:color/white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <!-- Stop Button (Red) -->
        <Button
            android:id="@+id/stopButton"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Stop"
            android:textColor="@android:color/white"
            android:background="@color/functional_red"
            android:drawableStart="@drawable/ic_stop"
            android:drawableTint="@android:color/white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

    </LinearLayout>

</LinearLayout>