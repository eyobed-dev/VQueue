<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_large">

        <!-- Header -->
        <TextView
            android:id="@+id/headerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="You're in Queue"
            android:textSize="@dimen/text_size_header"
            android:textStyle="bold"
                    android:textColor="?attr/android:textColorPrimary"
            android:gravity="center"
            android:layout_marginTop="@dimen/margin_xlarge"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Queue Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/queueStatusCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_xlarge"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="?attr/colorSurface"
            app:layout_constraintTop_toBottomOf="@id/headerText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_large">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Position"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold"
                            android:textColor="?attr/android:textColorPrimary"
                    android:layout_marginBottom="@dimen/margin_medium" />

                <TextView
                    android:id="@+id/positionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Position: #3"
                    android:textSize="@dimen/text_size_title"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="@dimen/margin_small" />

                <TextView
                    android:id="@+id/estimatedWaitText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimated Wait: 15 minutes"
                    android:textSize="@dimen/text_size_medium"
            android:textColor="?attr/android:textColorSecondary"
                    android:layout_marginBottom="@dimen/margin_small" />

                <TextView
                    android:id="@+id/currentNumberText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Currently Serving: #2"
                    android:textSize="@dimen/text_size_medium"
            android:textColor="?attr/android:textColorSecondary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Progress Indicator -->
        <ProgressBar
            android:id="@+id/waitProgressBar"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginTop="@dimen/margin_xlarge"
            android:progress="60"
            android:max="100"
            style="?android:attr/progressBarStyleHorizontal"
            app:layout_constraintTop_toBottomOf="@id/queueStatusCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Status Text -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:text="Please wait... You will be notified when it's your turn. Tap Home to leave the app if you want"
            android:textSize="@dimen/text_size_body"
            android:textColor="?attr/android:textColorSecondary"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/waitProgressBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Leave Queue Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/leaveQueueButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_large"
            android:layout_marginTop="@dimen/margin_xxlarge"
            android:text="Leave Queue"
            android:textSize="@dimen/text_size_body"
            android:textColor="?attr/colorOnSurface"
            app:backgroundTint="?attr/colorSurface"
            app:strokeWidth="2dp"
            app:layout_constraintTop_toBottomOf="@id/statusText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
