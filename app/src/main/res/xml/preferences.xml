<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:title="Testing Features"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:key="show_all_devices"
            app:title="Show All BLE Devices"
            app:iconSpaceReserved="false"
            app:summary="Display all nearby Bluetooth devices in queue search (for testing)"
            app:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="General"
        app:iconSpaceReserved="false">

        <ListPreference
            app:key="theme_preference"
            app:title="App Theme"
            app:iconSpaceReserved="false"
            app:summary="Choose between light and dark mode"
            app:dialogTitle="Select Theme"
            app:defaultValue="system"
            app:entries="@array/theme_entries"
            app:entryValues="@array/theme_values" />

    </PreferenceCategory>

</PreferenceScreen>
