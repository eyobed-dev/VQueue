<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Canonical app palette (new names) ===== -->

    <!-- Brand colors -->
    <color name="colorPrimary">#C80000</color>
    <color name="colorPrimaryDark">#A00000</color>
    <color name="colorPrimaryLight">#FFF5E6E6</color>

    <!-- Backgrounds -->
    <color name="colorBackground">#FFF5F5F5</color>
    <color name="colorSurface">#FFFFFFFF</color>
    <color name="colorDivider">#FFE0E0E0</color>

    <!-- Text -->
    <color name="colorTextPrimary">#FF212121</color>
    <color name="colorTextSecondary">#FF757575</color>
    <color name="colorTextOnPrimary">#FFFFFFFF</color>

    <!-- Buttons / status -->
    <color name="colorButtonPositive">#4CAF50</color>   <!-- green -->
    <color name="colorButtonNeutral">#FFC107</color>    <!-- amber -->
    <color name="colorButtonDanger">#F44336</color>     <!-- red -->


    <!-- ===== Legacy names kept for compatibility ===== -->
    <!-- (pour ne pas casser les vieux layouts / styles) -->

    <!-- Old brand names -->
    <color name="primary">@color/colorPrimary</color>
    <color name="primary_dark">@color/colorPrimaryDark</color>
    <color name="accent">@color/colorButtonPositive</color>

    <!-- Old background names -->
    <color name="background_primary">@color/colorBackground</color>
    <color name="background_secondary">@color/colorSurface</color>
    <color name="surface">@color/colorSurface</color>

    <!-- Old text names -->
    <color name="text_primary">@color/colorTextPrimary</color>
    <color name="text_secondary">@color/colorTextSecondary</color>
    <color name="text_hint">@color/colorTextSecondary</color>
    <color name="text_on_primary">@color/colorTextOnPrimary</color>

    <!-- Old status names -->
    <color name="success">@color/colorButtonPositive</color>
    <color name="warning">@color/colorButtonNeutral</color>
    <color name="error">@color/colorButtonDanger</color>

</resources>